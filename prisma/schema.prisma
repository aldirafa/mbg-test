// Skema Prisma - Sistem MBG Digital Triangulasi
// MVP (Bagian 6.1-6.3 Concept Note + Bagian 5 Dokumen Teknis): users, sppg, sekolah,
// siswa, orangtua, menu_harian, distribusi, konfirmasi_orangtua, flag_triangulasi.
// Fase 2 (Bagian 11.2 roadmap): feedback_anak, rating, pengaduan -- lihat komentar di
// tiap model masing-masing utk rujukan bagian dokumen & keputusan implementasi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  sppg
  sekolah
  orangtua
  dinas
  admin
}

enum StatusDistribusi {
  dikirim
  diterima
  bermasalah
}

enum StatusTerimaAnak {
  diterima
  tidak_diterima
  ada_masalah
}

enum StatusFlag {
  terbuka
  ditindaklanjuti
  selesai
}

model User {
  id           String   @id @default(cuid())
  nama         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  sppg      Sppg?
  sekolah   Sekolah?
  orangtua  Orangtua?

  @@map("users")
}

model Sppg {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  namaSppg    String   @map("nama_sppg")
  alamat      String
  kontak      String?
  statusAktif Boolean  @default(true) @map("status_aktif")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sekolahList Sekolah[]
  menuHarian  MenuHarian[]
  ratings     Rating[]
  pengaduan   Pengaduan[]

  @@map("sppg")
}

model Sekolah {
  id           String @id @default(cuid())
  userId       String @unique @map("user_id")
  namaSekolah  String @map("nama_sekolah")
  alamat       String
  sppgId       String @map("sppg_id")
  jumlahSiswa  Int?   @map("jumlah_siswa")
  // Lokasi sekolah, dipakai sbg titik acuan geo-gate Child Voice Interface (Fase 2)
  lat          Float?
  lng          Float?

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sppg   Sppg      @relation(fields: [sppgId], references: [id])
  siswa  Siswa[]
  distribusi Distribusi[]
  ratings       Rating[]
  pengaduanList Pengaduan[]

  @@map("sekolah")
}

model Orangtua {
  id         String  @id @default(cuid())
  userId     String  @unique @map("user_id")
  nama       String
  noWa       String? @map("no_wa")
  verifiedWa Boolean @default(false) @map("verified_wa")

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  siswa Siswa[]
  ratings       Rating[]
  pengaduanList Pengaduan[]

  @@map("orangtua")
}

model Siswa {
  id         String  @id @default(cuid())
  sekolahId  String  @map("sekolah_id")
  nama       String
  nisNisn    String  @unique @map("nis_nisn")
  kelas      String?
  orangtuaId String? @map("orangtua_id")

  sekolah             Sekolah              @relation(fields: [sekolahId], references: [id])
  orangtua            Orangtua?            @relation(fields: [orangtuaId], references: [id])
  konfirmasiOrangtua  KonfirmasiOrangtua[]
  feedbackAnak        FeedbackAnak[]

  @@map("siswa")
}

model MenuHarian {
  id            String   @id @default(cuid())
  sppgId        String   @map("sppg_id")
  tanggal       DateTime @db.Date
  deskripsi     String
  fotoUrl       String?  @map("foto_url")
  // Geotag = bukti lokasi produksi/pengiriman (evidence), BUKAN gate akses
  geotagKirimLat Float?  @map("geotag_kirim_lat")
  geotagKirimLng Float?  @map("geotag_kirim_lng")
  jumlahPorsi   Int      @map("jumlah_porsi")

  // Nomor menu & siklus (mis. "Menu 8 Siklus 2") + nilai gizi per kategori usia, diminta
  // tim Prof Elly (Teh Lingga) supaya ikut ditampilkan di pesan siap-bagi ke sekolah.
  // WAJIB diisi di form upload SPPG (lihat zod schema di API route) -- tapi kolomnya
  // dibiarkan nullable di level DB, biar data menu lama (sebelum field ini ada) gak
  // rusak/perlu di-backfill paksa.
  nomorMenu     Int?     @map("nomor_menu")
  siklus        Int?
  // Kategori I = anak SD, Kategori II = SMP ke atas (Bagian 8 Dok Teknis/kesepakatan chat).
  energiKategoriI       Float? @map("energi_kategori_1")
  proteinKategoriI      Float? @map("protein_kategori_1")
  lemakKategoriI        Float? @map("lemak_kategori_1")
  karbohidratKategoriI  Float? @map("karbohidrat_kategori_1")
  energiKategoriII      Float? @map("energi_kategori_2")
  proteinKategoriII     Float? @map("protein_kategori_2")
  lemakKategoriII       Float? @map("lemak_kategori_2")
  karbohidratKategoriII Float? @map("karbohidrat_kategori_2")

  sppg        Sppg         @relation(fields: [sppgId], references: [id])
  distribusi  Distribusi[]

  @@map("menu_harian")
}

model Distribusi {
  id               String            @id @default(cuid())
  menuId           String            @map("menu_id")
  sekolahId        String            @map("sekolah_id")
  status           StatusDistribusi  @default(dikirim)
  waktuKirim       DateTime?         @map("waktu_kirim")
  waktuTerima      DateTime?         @map("waktu_terima")
  porsiDiterima    Int?              @map("porsi_diterima")
  fotoTerimaUrl    String?           @map("foto_terima_url")
  // Geotag = bukti lokasi (evidence), BUKAN gate akses -- beda peran dgn feedback_anak (Fase 2)
  geotagTerimaLat  Float?            @map("geotag_terima_lat")
  geotagTerimaLng  Float?            @map("geotag_terima_lng")
  // Catatan singkat sekolah saat menandai status jadi bermasalah (mis. porsi kurang,
  // kualitas menurun). Komplain ringkas per-distribusi -- bukan sistem pengaduan trackable
  // penuh (itu entitas pengaduan, Fase 2, Bagian 6.5).
  catatan          String?

  menu               MenuHarian           @relation(fields: [menuId], references: [id])
  sekolah            Sekolah              @relation(fields: [sekolahId], references: [id])
  konfirmasiOrangtua KonfirmasiOrangtua[]
  flagTriangulasi    FlagTriangulasi[]
  feedbackAnak       FeedbackAnak[]
  pengaduanList      Pengaduan[]

  @@map("distribusi")
}

model KonfirmasiOrangtua {
  id           String            @id @default(cuid())
  distribusiId String            @map("distribusi_id")
  siswaId      String            @map("siswa_id")
  statusTerima StatusTerimaAnak  @map("status_terima")
  catatan      String?
  fotoUrl      String?           @map("foto_url")
  createdAt    DateTime          @default(now()) @map("created_at")

  distribusi Distribusi @relation(fields: [distribusiId], references: [id])
  siswa      Siswa      @relation(fields: [siswaId], references: [id])

  @@map("konfirmasi_orangtua")
}

// Dihasilkan oleh job triangulasi otomatis (bandingkan SPPG - Sekolah - Orangtua)
model FlagTriangulasi {
  id                  String     @id @default(cuid())
  distribusiId        String     @map("distribusi_id")
  jenisKetidaksesuaian String    @map("jenis_ketidaksesuaian")
  detail              String
  status              StatusFlag @default(terbuka)
  createdAt           DateTime   @default(now()) @map("created_at")

  distribusi Distribusi @relation(fields: [distribusiId], references: [id])

  @@map("flag_triangulasi")
}

enum StatusPengaduan {
  diterima
  ditindaklanjuti
  selesai
}

// Fase 2, Bagian 6.7 Concept Note & Bagian 3.3 Dok Teknis -- kanal suara anak via QR,
// tanpa login. NIS/NISN dipakai CUMA buat resolve ke siswa & cegah submit dobel per
// distribusi (bukan buat pencarian bebas) -- lihat unique constraint di bawah. Nama &
// NIS/NISN siswa di balik satu entri feedback cuma ditampilkan ke role admin di dashboard
// Dinas (bukan role dinas biasa), sesuai kesepakatan konsep -- lihat README.
model FeedbackAnak {
  id                  String   @id @default(cuid())
  distribusiId        String   @map("distribusi_id")
  siswaId             String   @map("siswa_id")
  suka                Boolean
  habis               Boolean
  catatanPerbaikan    String?  @map("catatan_perbaikan")
  geotagLat           Float?   @map("geotag_lat")
  geotagLng           Float?   @map("geotag_lng")
  // true = lokasi perangkat konsisten dgn radius 10m dari titik acuan sekolah saat submit.
  // false (GPS lemah/ditolak/di luar radius) -> tetap disimpan, ditandai buat ditinjau
  // manual, BUKAN ditolak otomatis (Bagian 3.3 Dok Teknis).
  lokasiTerverifikasi Boolean  @default(false) @map("lokasi_terverifikasi")
  createdAt           DateTime @default(now()) @map("created_at")

  distribusi Distribusi @relation(fields: [distribusiId], references: [id])
  siswa      Siswa      @relation(fields: [siswaId], references: [id])

  // Satu anak cuma bisa ngisi sekali per distribusi (hari) -- inti dari "cegah submit dobel".
  @@unique([distribusiId, siswaId])
  @@map("feedback_anak")
}

// Fase 2, Bagian 6.4 -- skor berkala dari sekolah & orangtua ke SPPG. MVP: rater bisa
// ngirim kapan aja (belum ada pembatasan frekuensi "berkala" secara ketat -- disederhanakan,
// lihat README), riwayatnya disimpan semua, skor SPPG = rata-rata seluruh riwayat.
// Rater (persis salah satu): sekolahId ATAU orangtuaId -- dijaga di application layer.
model Rating {
  id         String   @id @default(cuid())
  sppgId     String   @map("sppg_id")
  sekolahId  String?  @map("sekolah_id")
  orangtuaId String?  @map("orangtua_id")
  skor       Int
  catatan    String?
  createdAt  DateTime @default(now()) @map("created_at")

  sppg     Sppg      @relation(fields: [sppgId], references: [id])
  sekolah  Sekolah?  @relation(fields: [sekolahId], references: [id])
  orangtua Orangtua? @relation(fields: [orangtuaId], references: [id])

  @@map("rating")
}

// Fase 2, Bagian 6.5 -- beda dari distribusi.catatan (komplain ringkas per-distribusi,
// MVP). Ini kanal pengaduan trackable penuh: bisa dari sekolah ATAUPUN orangtua, gak
// harus terikat 1 distribusi tertentu (distribusiId opsional), dan Dinas yang kelola
// status-nya end-to-end (diterima -> ditindaklanjuti -> selesai).
model Pengaduan {
  id           String          @id @default(cuid())
  sekolahId    String?         @map("sekolah_id")
  orangtuaId   String?         @map("orangtua_id")
  sppgId       String?         @map("sppg_id")
  distribusiId String?         @map("distribusi_id")
  isi          String
  fotoUrl      String?         @map("foto_url")
  status       StatusPengaduan @default(diterima)
  createdAt    DateTime        @default(now()) @map("created_at")

  sekolah    Sekolah?    @relation(fields: [sekolahId], references: [id])
  orangtua   Orangtua?   @relation(fields: [orangtuaId], references: [id])
  sppg       Sppg?       @relation(fields: [sppgId], references: [id])
  distribusi Distribusi? @relation(fields: [distribusiId], references: [id])

  @@map("pengaduan")
}
